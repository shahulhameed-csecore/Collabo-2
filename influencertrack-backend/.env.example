ENVIRONMENT=production
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ALLOWED_ORIGINS=https://your-frontend-domain.com
SENTRY_DSN=your-sentry-dsn-optional
# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_INTENT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# WhatsApp / Meta Cloud API
WHATSAPP_TOKEN=your-whatsapp-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# Email Reminders — Option 1: Direct SMTP (Gmail / Custom SMTP)
SMTP_EMAIL=collabo.reminders@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Email Reminders — Option 2: Resend API
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Scheduler (how often to check deadlines, in minutes)
SCHEDULER_INTERVAL_MINUTES=60

# Manual reminder trigger secret (POST /internal/trigger-reminders)
# Set to any random string (e.g. openssl rand -hex 16)
# Leave empty to disable the debug endpoint entirely.
INTERNAL_SECRET=

# Telegram Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Razorpay Integration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Dynamic Pricing Config
PRO_MONTHLY_INR=300
PRO_ANNUAL_INR=3000

# Redis Cache (Horizontal Scaling & WhatsApp Batching)
REDIS_URL=redis://localhost:6379/0
