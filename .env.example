ENVIRONMENT=production
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ALLOWED_ORIGINS=https://your-frontend-domain.com
SENTRY_DSN=your-sentry-dsn-optional

# WhatsApp / Meta Cloud API
WHATSAPP_TOKEN=your-whatsapp-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# Email reminders via Resend
RESEND_API_KEY=your-resend-api-key

# Scheduler (how often to check deadlines, in minutes)
SCHEDULER_INTERVAL_MINUTES=60

# Manual reminder trigger secret (POST /internal/trigger-reminders)
# Set to any random string (e.g. openssl rand -hex 16)
# Leave empty to disable the debug endpoint entirely.
INTERNAL_SECRET=
